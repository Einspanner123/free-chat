# ==============================
# FreeChat Environment Variables
# ==============================
# Copy this file to .env and modify for your deployment.
# cp .env.example .env

# ---- Service Discovery ----
# Set a fixed IP for Consul registration (required for distributed deployment).
# Leave empty for single-node (auto-detected via docker bridge IP).
ADVERTISE_IP=

# Control plane IP for distributed deployment (compute plane connects here)
CONTROL_PLANE_IP=

# ---- API Gateway ----
API_GATEWAY_PORT=8080

# ---- Auth Service ----
AUTH_SERVER_NAME=auth-service
AUTH_GRPC_PORT=8082
AUTH_JWT_SECRET=change-me-to-a-random-secret
AUTH_EXPIRE_ACCESS_H=1
AUTH_EXPIRE_REFRESH_H=72

# ---- Chat Service ----
CHAT_SERVER_NAME=chat-service
CHAT_GRPC_PORT=8088

# ---- PostgreSQL ----
POSTGRES_ADDRESS=localhost
POSTGRES_PORT=5432
POSTGRES_USER=free-chat
POSTGRES_PASSWORD=change-me-to-a-random-password
POSTGRES_DB_NAME=free-chat

# ---- Redis ----
REDIS_ADDRESS=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_RATE_LIMIT_QPS=10

# ---- Consul ----
CONSUL_ADDRESS=localhost:8500
CONSUL_SCHEME=http
CONSUL_DATACENTER=dc1

# ---- RocketMQ ----
ROCKETMQ_NAME_SERVERS=localhost:9876
ROCKETMQ_CONSUMER_GROUP=chat-consumer

# ---- LLM Inference ----
LLM_SERVER_NAME=llm-inference
LLM_GRPC_PORT=8083
LLM_MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.9
LLM_MAX_TOKENS=1000
LLM_MAX_WORKERS=10

# ---- Engine & Quantization (NEW in v0.2) ----
# Engine type: auto, vllm, hf
ENGINE_TYPE=auto
# Quantization: (empty for FP16), awq, gptq, squeezellm
QUANTIZATION=
# vLLM-specific settings
GPU_MEMORY_UTILIZATION=0.9
TENSOR_PARALLEL_SIZE=1
MAX_MODEL_LEN=8192

# ---- Global ----
APP_ENV=development
