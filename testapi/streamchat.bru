meta {
  name: streamchat
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/v1/chat/sessions/stream
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{jwt_token}}
}

body:json {
  {
    "session_id": "{{session_id}}",
    "message": "你好，请介绍一下你自己"
  }
}

docs {
  Stream chat with LLM. Obtain jwt_token via login first,
  then create a session to get session_id.
}
