meta {
  name: send_message
  type: http
  seq: 5
}

post {
  url: {{base_url}}/api/v1/chat/sessions/messages
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{jwt_token}}
}

body:json {
  {
    "session_id": "{{session_id}}",
    "message": "请用中文回答：什么是微服务架构？"
  }
}

settings {
  encodeUrl: true
  timeout: 30
}
