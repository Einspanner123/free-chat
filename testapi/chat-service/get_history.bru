meta {
  name: get_history
  type: http
  seq: 3
}

get {
  url: {{base_url}}/api/v1/chat/sessions/{{session_id}}/history?limit=50&offset=0
  body: none
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{jwt_token}}
}

settings {
  encodeUrl: true
  timeout: 0
}
