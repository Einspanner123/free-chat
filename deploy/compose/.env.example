FREECHAT_API_KEYS=development:replace-this-development-key
FREECHAT_CACHE_SALT_SECRET=replace-with-at-least-32-bytes-for-development
FREECHAT_DEFAULT_WORKER_ENDPOINT=http://host.docker.internal:8000
# Optional trusted routing origin; must match a registered Worker node_id.
FREECHAT_ORIGIN_NODE_ID=
MINIO_ROOT_USER=freechat-development
MINIO_ROOT_PASSWORD=replace-this-development-password

FREECHAT_WORKER_TOKEN=replace-with-at-least-32-random-characters
